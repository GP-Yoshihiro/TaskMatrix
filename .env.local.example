# Supabase プロジェクト URL（クライアントからも参照される）
NEXT_PUBLIC_SUPABASE_URL=

# Supabase 匿名キー（RLS 前提。クライアントからも参照される）
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 管理操作用キー。第1フェーズでは未使用。サーバー専用であり絶対に公開しない
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API キー（サーバー専用・絶対に公開しない）
# https://aistudio.google.com/apikey で取得する
GEMINI_API_KEY=

# 使用するモデル。未設定なら gemini-3.7-flash
GEMINI_MODEL=gemini-3.7-flash

# 既定モデルが混雑しているときの代替。未設定なら gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
